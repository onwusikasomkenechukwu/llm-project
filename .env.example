# Copy to .env and fill in. Never commit .env.
# Only the providers you actually list in configs/experiment.yaml are required.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: for a local/self-hosted OpenAI-compatible server (vLLM, Ollama, llama.cpp).
# The key is usually ignored by these servers but the adapter still reads the variable.
LOCAL_API_KEY=not-needed
