# Copy to .env and fill in the providers you actually use. Never commit .env.
# run.py and judge.py read these from the environment only.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Meta Model API (Muse). Meta's Llama API shut down on 2026-07-06.
MODEL_API_KEY=

# Local OpenAI-compatible server (vLLM, Ollama, llama.cpp). The server usually
# ignores the key, but the SDK still requires the variable to be set.
LOCAL_API_KEY=not-needed
